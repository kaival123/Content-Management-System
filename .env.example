# Copy to .env and fill in. Used by docker-compose.yml. Never commit the real .env.

# The domain your CMS is served at (must match the site label in Caddyfile).
CMS_DOMAIN=app.yourdomain.com

# Long random string used to sign things. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# The first admin account, seeded on first boot. Change the password immediately after.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=change-me
