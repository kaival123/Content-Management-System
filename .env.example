# Copy to .env and fill in. Used by docker-compose.yml. Never commit the real .env.

# The domain the CMS builder is served at — your MAIN domain (must match the app site in
# Caddyfile). Use the apex, e.g. cms.com (or app.cms.com if you prefer a subdomain).
CMS_DOMAIN=cms.com

# Base domain for published-site subdomains → each site is live at <slug>.cms.com.
# Needs a wildcard DNS record (*.cms.com) pointing at this server. Usually the same as above.
CMS_SITE_DOMAIN=cms.com

# Long random string used to sign things. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# The first admin account, seeded on first boot. Change the password immediately after.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=change-me

# --- Form-submission email notifications (optional) ---
# When set, the site owner is emailed on each contact-form submission.
# Leave blank to disable (submissions are still stored and shown in the app).
EMAIL_PROVIDER=resend            # "resend" or "sendgrid"
EMAIL_API_KEY=                   # your provider API key
EMAIL_FROM=CMS <no-reply@yourdomain.com>   # a verified sender for your provider
