{
  "type": "footer",
  "label": "Footer",
  "description": "Brand, links and copyright",
  "icon": "layout",
  "fields": [
    {
      "key": "brand",
      "label": "Brand name",
      "type": "text"
    },
    {
      "key": "tagline",
      "label": "Tagline",
      "type": "text"
    },
    {
      "key": "useSiteMenu",
      "label": "Use the website's page menu (links to every page; sub-pages become dropdowns)",
      "type": "toggle"
    },
    {
      "key": "links",
      "label": "Custom links (used when the page menu is off)",
      "type": "list",
      "itemLabel": "Link",
      "itemFields": [
        {
          "key": "label",
          "label": "Label",
          "type": "text"
        },
        {
          "key": "href",
          "label": "Link",
          "type": "url",
          "placeholder": "#features"
        }
      ]
    },
    {
      "key": "socials",
      "label": "Social links",
      "type": "list",
      "itemLabel": "Social link",
      "itemFields": [
        {
          "key": "label",
          "label": "Name (e.g. Twitter)",
          "type": "text"
        },
        {
          "key": "href",
          "label": "Link",
          "type": "url"
        }
      ]
    },
    {
      "key": "layout",
      "label": "Footer layout",
      "type": "select",
      "options": [
        {
          "label": "Spread — brand left, links right",
          "value": "spread"
        },
        {
          "label": "Centered",
          "value": "centered"
        },
        {
          "label": "Stacked, left aligned",
          "value": "stacked"
        },
        {
          "label": "Columns — brand, links, social",
          "value": "columns"
        }
      ]
    },
    {
      "key": "linkStyle",
      "label": "Link style",
      "type": "select",
      "options": [
        {
          "label": "Plain",
          "value": "plain"
        },
        {
          "label": "Underline on hover",
          "value": "underline"
        },
        {
          "label": "Pills",
          "value": "pills"
        }
      ]
    },
    {
      "key": "divider",
      "label": "Line above copyright",
      "type": "select",
      "options": [
        {
          "label": "Line",
          "value": "line"
        },
        {
          "label": "None",
          "value": "none"
        }
      ]
    },
    {
      "key": "copyrightAlign",
      "label": "Copyright alignment",
      "type": "select",
      "options": [
        {
          "label": "Match layout",
          "value": "auto"
        },
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
    {
      "key": "copyright",
      "label": "Copyright text",
      "type": "text"
    }
  ],
  "elements": [
    {
      "key": "brand",
      "label": "Brand name",
      "kind": "text",
      "fields": [
        "brand"
      ]
    },
    {
      "key": "tagline",
      "label": "Tagline",
      "kind": "text",
      "fields": [
        "tagline"
      ]
    },
    {
      "key": "link",
      "label": "Links",
      "kind": "text",
      "list": "links",
      "fields": [
        "label",
        "href"
      ]
    },
    {
      "key": "menuLink",
      "label": "Page menu links",
      "kind": "text",
      "fields": [
        "useSiteMenu"
      ]
    },
    {
      "key": "copyright",
      "label": "Copyright",
      "kind": "text",
      "fields": [
        "copyright"
      ]
    },
    {
      "key": "social",
      "label": "Social links",
      "kind": "text",
      "fields": [
        "socials"
      ],
      "list": "socials"
    }
  ],
  "defaults": {
    "brand": "Brand",
    "tagline": "Making work simpler.",
    "links": [
      {
        "label": "Privacy",
        "href": "#"
      },
      {
        "label": "Terms",
        "href": "#"
      },
      {
        "label": "Contact",
        "href": "#contact"
      }
    ],
    "copyright": "© 2026 Brand. All rights reserved.",
    "useSiteMenu": false,
    "socials": [],
    "layout": "spread",
    "linkStyle": "plain",
    "divider": "line",
    "copyrightAlign": "auto"
  },
  "defaultStyle": {
    "paddingY": 40,
    "background": "#0f172a",
    "textColor": "#cbd5e1"
  }
}
