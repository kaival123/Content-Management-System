    },
    { "key": "heading", "label": "Heading", "type": "text" },
    { "key": "text", "label": "Text", "type": "textarea" },
    { "key": "buttonLabel", "label": "Button label", "type": "text" },
    { "key": "switchText", "label": "Switch text (e.g. \"No account yet?\")", "type": "text" },
    { "key": "switchLabel", "label": "Switch link label", "type": "text" },
    { "key": "switchHref", "label": "Switch link", "type": "url" },
    { "key": "action", "label": "Form action URL (your auth endpoint)", "type": "url" },
    { "key": "image", "label": "Side image", "type": "image" }
  ],
  "elements": [
    { "key": "heading", "label": "Heading", "kind": "text", "fields": ["heading"] },
