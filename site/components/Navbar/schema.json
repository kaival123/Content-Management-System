{
  "type": "navbar",
  "label": "Navigation bar",
  "description": "Logo, menu links and a call-to-action button",
  "icon": "menu",
  "fields": [
    {
      "key": "brand",
      "label": "Brand name",
      "type": "text"
    },
    {
      "key": "logo",
      "label": "Logo image",
      "type": "image"
    },
    {
      "key": "useSiteMenu",
      "label": "Use the website's page menu (links to every page; sub-pages become dropdowns)",
      "type": "toggle"
    },
    {
      "key": "links",
      "label": "Custom links (used when the page menu is off)",
      "type": "list",
      "itemLabel": "Link",
      "itemFields": [
        {
          "key": "label",
          "label": "Label",
          "type": "text"
        },
        {
          "key": "href",
          "label": "Link",
          "type": "url",
          "placeholder": "#features"
        }
      ]
    },
    {
      "key": "ctaLabel",
      "label": "Button label",
      "type": "text"
    },
    {
      "key": "ctaHref",
      "label": "Button link",
      "type": "url"
    },
    {
      "key": "layout",
      "label": "Header layout",
      "type": "select",
      "options": [
        {
          "label": "Logo left, links right",
          "value": "default"
        },
        {
          "label": "Links centered between logo and button",
          "value": "centered"
        },
        {
          "label": "Links left, button right",
          "value": "links-left"
        },
        {
          "label": "Stacked — logo above links",
          "value": "stacked"
        }
      ]
    },
    {
      "key": "linkStyle",
      "label": "Link style",
      "type": "select",
      "options": [
        {
          "label": "Plain",
          "value": "plain"
        },
        {
          "label": "Underline on hover",
          "value": "underline"
        },
        {
          "label": "Pills",
          "value": "pills"
        },
        {
          "label": "Dot under active",
          "value": "dot"
        }
      ]
    },
    {
      "key": "ctaStyle",
      "label": "Button style",
      "type": "select",
      "options": [
        {
          "label": "Solid",
          "value": "solid"
        },
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Soft",
          "value": "soft"
        },
        {
          "label": "Pill",
          "value": "pill"
        }
      ]
    },
    {
      "key": "barStyle",
      "label": "Bar style",
      "type": "select",
      "options": [
        {
          "label": "Bottom line",
          "value": "line"
        },
        {
          "label": "Shadow",
          "value": "shadow"
        },
        {
          "label": "Plain",
          "value": "none"
        },
        {
          "label": "Floating rounded bar",
          "value": "floating"
        }
      ]
    },
    {
      "key": "mobileMenu",
      "label": "Mobile menu",
      "type": "select",
      "options": [
        {
          "label": "Dropdown panel",
          "value": "dropdown"
        },
        {
          "label": "Floating card",
          "value": "card"
        },
        {
          "label": "Full screen",
          "value": "full"
        }
      ]
    },
    {
      "key": "sticky",
      "label": "Stick to top on scroll",
      "type": "toggle"
    },
    {
      "key": "topBar",
      "label": "Show the accessibility top bar (mini header) above the menu",
      "type": "toggle"
    },
    {
      "key": "topLogo",
      "label": "Top bar logo / emblem",
      "type": "image"
    },
    {
      "key": "topTitle",
      "label": "Top bar title",
      "type": "text"
    },
    {
      "key": "topLinks",
      "label": "Top bar quick links",
      "type": "list",
      "itemLabel": "Link",
      "itemFields": [
        {
          "key": "label",
          "label": "Label",
          "type": "text"
        },
        {
          "key": "href",
          "label": "Link (#main = skip to content, #screen-reader = screen reader mode)",
          "type": "text"
        }
      ]
    },
    {
      "key": "topFontSize",
      "label": "Show text size − A +",
      "type": "toggle"
    },
    {
      "key": "topLanguages",
      "label": "Languages (empty = no dropdown)",
      "type": "list",
      "itemLabel": "Language",
      "itemFields": [
        {
          "key": "label",
          "label": "Name",
          "type": "text"
        },
        {
          "key": "code",
          "label": "Language code (hi, gu, fr…)",
          "type": "text"
        },
        {
          "key": "href",
          "label": "Own page link (empty = auto-translate)",
          "type": "text"
        }
      ]
    },
    {
      "key": "topThemeLabel",
      "label": "Theme label",
      "type": "text"
    },
    {
      "key": "topThemes",
      "label": "Themes (dots): colours applied to the whole page",
      "type": "list",
      "itemLabel": "Theme",
      "itemFields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text"
        },
        {
          "key": "color",
          "label": "Accent colour (buttons, links)",
          "type": "color"
        },
        {
          "key": "background",
          "label": "Page background",
          "type": "color"
        },
        {
          "key": "surface",
          "label": "Cards / surface colour",
          "type": "color"
        },
        {
          "key": "text",
          "label": "Text colour",
          "type": "color"
        },
        {
          "key": "dot",
          "label": "Dot colour (empty = accent)",
          "type": "color"
        }
      ]
    },
    {
      "key": "topKeepColors",
      "label": "Keep the page colours until a theme dot is clicked",
      "type": "toggle"
    },
    {
      "key": "topPillStyle",
      "label": "Top bar button style",
      "type": "select",
      "options": [
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Filled",
          "value": "filled"
        },
        {
          "label": "Plain",
          "value": "plain"
        }
      ]
    },
    {
      "key": "topBarColor",
      "label": "Top bar colour",
      "type": "select",
      "options": [
        {
          "label": "Selected theme (default)",
          "value": "theme"
        },
        {
          "label": "Custom",
          "value": "custom"
        }
      ]
    },
    {
      "key": "topBg",
      "label": "Custom top bar background",
      "type": "color"
    },
    {
      "key": "topText",
      "label": "Custom top bar text colour",
      "type": "color"
    }
  ],
  "elements": [
    {
      "key": "logo",
      "label": "Logo",
      "kind": "image",
      "fields": [
        "logo"
      ]
    },
    {
      "key": "brand",
      "label": "Brand name",
      "kind": "text",
      "fields": [
        "brand"
      ]
    },
    {
      "key": "link",
      "label": "Menu links",
      "kind": "text",
      "list": "links",
      "fields": [
        "label",
        "href"
      ]
    },
    {
      "key": "menuLink",
      "label": "Page menu links",
      "kind": "text",
      "fields": [
        "useSiteMenu"
      ]
    },
    {
      "key": "cta",
      "label": "Button",
      "kind": "button",
      "fields": [
        "ctaLabel",
        "ctaHref"
      ]
    },
    {
      "key": "topbar",
      "label": "Accessibility top bar",
      "kind": "box",
      "fields": [
        "topBar",
        "topLogo",
        "topTitle",
        "topLinks",
        "topFontSize",
        "topLanguages",
        "topThemeLabel",
        "topThemes",
        "topKeepColors",
        "topPillStyle",
        "topBarColor",
        "topBg",
        "topText"
      ]
    }
  ],
  "defaults": {
    "brand": "Brand",
    "logo": "",
    "links": [
      {
        "label": "Features",
        "href": "#features"
      },
      {
        "label": "Pricing",
        "href": "#pricing"
      },
      {
        "label": "FAQ",
        "href": "#faq"
      }
    ],
    "ctaLabel": "Get started",
    "ctaHref": "#cta",
    "sticky": true,
    "useSiteMenu": false,
    "layout": "default",
    "linkStyle": "plain",
    "ctaStyle": "solid",
    "barStyle": "line",
    "mobileMenu": "dropdown",
    "topBar": false,
    "topLogo": "",
    "topTitle": "Government of India, Ministry of Health",
    "topLinks": [
      {
        "label": "Skip to Main Content",
        "href": "#main"
      },
      {
        "label": "Screen Reader Access",
        "href": "#screen-reader"
      }
    ],
    "topFontSize": true,
    "topLanguages": [
      {
        "label": "English",
        "code": "en",
        "href": ""
      },
      {
        "label": "हिन्दी",
        "code": "hi",
        "href": ""
      },
      {
        "label": "ગુજરાતી",
        "code": "gu",
        "href": ""
      }
    ],
    "topThemeLabel": "Theme:",
    "topThemes": [
      {
        "name": "Amber",
        "color": "#d97706",
        "background": "#fff1d6",
        "surface": "#fffaf0",
        "text": "#3b2a12"
      },
      {
        "name": "Red",
        "color": "#dc2626",
        "background": "#fde2e2",
