{
  "type": "navbar",
  "label": "Navigation bar",
  "description": "Logo, menu links and a call-to-action button",
  "icon": "menu",
  "fields": [
    {
      "key": "brand",
      "label": "Brand name",
      "type": "text"
    },
    {
      "key": "logo",
      "label": "Logo image",
      "type": "image"
    },
    {
      "key": "useSiteMenu",
      "label": "Use the website's page menu (links to every page; sub-pages become dropdowns)",
      "type": "toggle"
    },
    {
      "key": "links",
      "label": "Custom links (used when the page menu is off)",
      "type": "list",
      "itemLabel": "Link",
      "itemFields": [
        {
          "key": "label",
          "label": "Label",
          "type": "text"
        },
        {
          "key": "href",
          "label": "Link",
          "type": "url",
          "placeholder": "#features"
        }
      ]
    },
    {
      "key": "ctaLabel",
      "label": "Button label",
      "type": "text"
    },
    {
      "key": "ctaHref",
      "label": "Button link",
      "type": "url"
    },
    {
      "key": "layout",
      "label": "Header layout",
      "type": "select",
      "options": [
        {
          "label": "Logo left, links right",
          "value": "default"
        },
        {
          "label": "Links centered between logo and button",
          "value": "centered"
        },
        {
          "label": "Links left, button right",
          "value": "links-left"
        },
        {
          "label": "Stacked — logo above links",
          "value": "stacked"
        }
      ]
    },
    {
      "key": "linkStyle",
      "label": "Link style",
      "type": "select",
      "options": [
        {
          "label": "Plain",
          "value": "plain"
        },
        {
          "label": "Underline on hover",
          "value": "underline"
        },
        {
          "label": "Pills",
          "value": "pills"
        },
        {
          "label": "Dot under active",
          "value": "dot"
        }
      ]
    },
    {
      "key": "ctaStyle",
      "label": "Button style",
      "type": "select",
      "options": [
        {
          "label": "Solid",
          "value": "solid"
        },
        {
          "label": "Outline",
          "value": "outline"
        },
        {
          "label": "Soft",
          "value": "soft"
        },
        {
          "label": "Pill",
          "value": "pill"
        }
      ]
    },
    {
      "key": "barStyle",
      "label": "Bar style",
      "type": "select",
      "options": [
        {
          "label": "Bottom line",
          "value": "line"
        },
        {
          "label": "Shadow",
          "value": "shadow"
        },
        {
          "label": "Plain",
          "value": "none"
        },
        {
          "label": "Floating rounded bar",
          "value": "floating"
        }
      ]
    },
    {
      "key": "mobileMenu",
      "label": "Mobile menu",
      "type": "select",
      "options": [
        {
          "label": "Dropdown panel",
          "value": "dropdown"
        },
        {
          "label": "Floating card",
          "value": "card"
        },
        {
          "label": "Full screen",
          "value": "full"
        }
      ]
    },
    {
      "key": "sticky",
      "label": "Stick to top on scroll",
      "type": "toggle"
    }
  ],
  "elements": [
    {
      "key": "logo",
      "label": "Logo",
      "kind": "image",
      "fields": [
        "logo"
      ]
    },
    {
      "key": "brand",
      "label": "Brand name",
      "kind": "text",
      "fields": [
        "brand"
      ]
    },
    {
      "key": "link",
      "label": "Menu links",
      "kind": "text",
      "list": "links",
      "fields": [
        "label",
        "href"
      ]
    },
    {
      "key": "menuLink",
      "label": "Page menu links",
      "kind": "text",
      "fields": [
        "useSiteMenu"
      ]
    },
    {
      "key": "cta",
      "label": "Button",
      "kind": "button",
      "fields": [
        "ctaLabel",
        "ctaHref"
      ]
    }
  ],
  "defaults": {
    "brand": "Brand",
    "logo": "",
    "links": [
      {
        "label": "Features",
        "href": "#features"
      },
      {
        "label": "Pricing",
        "href": "#pricing"
      },
      {
        "label": "FAQ",
        "href": "#faq"
      }
    ],
    "ctaLabel": "Get started",
    "ctaHref": "#cta",
    "sticky": true,
    "useSiteMenu": false,
    "layout": "default",
    "linkStyle": "plain",
    "ctaStyle": "solid",
    "barStyle": "line",
    "mobileMenu": "dropdown"
  },
  "defaultStyle": {
    "paddingY": 16
  }
}
