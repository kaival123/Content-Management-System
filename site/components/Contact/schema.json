{
  "type": "contact",
  "label": "Contact form",
  "description": "Lead capture form with contact details",
  "icon": "mail",
  "fields": [
    {
      "key": "heading",
      "label": "Heading",
      "type": "text"
    },
    {
      "key": "text",
      "label": "Text",
      "type": "textarea"
    },
    {
      "key": "email",
      "label": "Email",
      "type": "text"
    },
    {
      "key": "phone",
      "label": "Phone",
      "type": "text"
    },
    {
      "key": "address",
      "label": "Address",
      "type": "textarea"
    },
    {
      "key": "mapAddress",
      "label": "Map address (empty = no map)",
      "type": "text"
    },
    {
      "key": "mapLayout",
      "label": "Map position",
      "type": "select",
      "options": [
        {
          "label": "Right of form",
          "value": "side"
        },
        {
          "label": "Left of form",
          "value": "side-reverse"
        },
        {
          "label": "Below form",
          "value": "below"
        }
      ]
    },
    {
      "key": "mapRadius",
      "label": "Map border radius (px)",
      "type": "number"
    },
    {
      "key": "mapShadow",
      "label": "Map shadow",
      "type": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Soft",
          "value": "soft"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        }
      ]
    },
    {
      "key": "buttonLabel",
      "label": "Submit button label",
      "type": "text"
    },
    {
      "key": "successMessage",
      "label": "Success message",
      "type": "text"
    }
  ],
  "elements": [
    {
      "key": "heading",
      "label": "Heading",
      "kind": "text",
      "fields": [
        "heading"
      ]
    },
    {
      "key": "text",
      "label": "Text",
      "kind": "text",
      "fields": [
        "text"
      ]
    },
    {
      "key": "details",
      "label": "Contact details",
      "kind": "text",
      "fields": [
        "email",
        "phone",
        "address"
      ]
    },
    {
      "key": "form",
      "label": "Form box",
      "kind": "box",
      "fields": [
        "buttonLabel",
        "successMessage"
      ]
    },
    {
      "key": "map",
      "label": "Google Map",
      "kind": "box",
      "fields": [
        "mapAddress",
        "mapLayout",
        "mapRadius",
        "mapShadow"
      ]
    },
    {
      "key": "submit",
      "label": "Submit button",
      "kind": "button",
      "fields": [
        "buttonLabel"
      ]
    }
  ],
  "defaults": {
    "anchor": "contact",
    "heading": "Get in touch",
    "text": "Have a question? Send us a message and we will get back to you within one business day.",
    "email": "hello@example.com",
    "phone": "+1 (555) 000-0000",
    "address": "123 Main Street\nSan Francisco, CA",
    "buttonLabel": "Send message",
    "successMessage": "Thanks! We will be in touch soon."
  }
}
