      { "name": "Lena Park", "role": "Lead Engineer", "bio": "", "photo": "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=600&q=80", "link": "" },
      { "name": "David Osei", "role": "Customer Success", "bio": "", "photo": "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=600&q=80", "link": "" }
    ]
