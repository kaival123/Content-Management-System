{
  "type": "team",
  "label": "Team",
  "description": "Grid of team members with photo, name and role",
  "icon": "users",
  "fields": [
    { "key": "heading", "label": "Heading", "type": "text" },
    { "key": "subheading", "label": "Subheading", "type": "textarea" },
    {
      "key": "members",
      "label": "Team members",
      "type": "list",
      "itemLabel": "Member",
      "itemFields": [
        { "key": "name", "label": "Name", "type": "text" },
        { "key": "role", "label": "Role", "type": "text" },
        { "key": "bio", "label": "Short bio", "type": "textarea" },
        { "key": "photo", "label": "Photo", "type": "image" },
        { "key": "link", "label": "Profile link (LinkedIn, etc.)", "type": "url" }
      ]
    }
  ],
  "elements": [
    { "key": "heading", "label": "Heading", "kind": "text", "fields": ["heading"] },
    { "key": "subheading", "label": "Subheading", "kind": "text", "fields": ["subheading"] },
    { "key": "card", "label": "Member cards", "kind": "box", "list": "members", "fields": ["name", "role", "bio", "photo", "link"] },
    { "key": "photo", "label": "Photos", "kind": "image", "list": "members", "fields": ["photo"] },
    { "key": "name", "label": "Names", "kind": "text", "list": "members", "fields": ["name"] },
    { "key": "role", "label": "Roles", "kind": "text", "list": "members", "fields": ["role"] }
  ],
