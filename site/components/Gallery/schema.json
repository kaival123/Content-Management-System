{
  "type": "gallery",
  "label": "Gallery",
  "description": "Image grid with captions (portfolio, photos, case studies)",
  "icon": "image",
  "fields": [
    { "key": "heading", "label": "Heading", "type": "text" },
    { "key": "subheading", "label": "Subheading", "type": "textarea" },
    {
      "key": "shape",
      "label": "Image shape",
      "type": "select",
      "options": [
        { "label": "Landscape (4:3)", "value": "4/3" },
        { "label": "Square", "value": "1/1" },
        { "label": "Portrait (3:4)", "value": "3/4" },
        { "label": "Wide (16:9)", "value": "16/9" }
      ]
    },
    { "key": "captionOnHover", "label": "Show captions on hover", "type": "toggle" },
    {
      "key": "images",
      "label": "Images",
      "type": "list",
      "itemLabel": "Image",
      "itemFields": [
        { "key": "image", "label": "Image", "type": "image" },
        { "key": "title", "label": "Title", "type": "text" },
        { "key": "caption", "label": "Caption / category", "type": "text" },
        { "key": "link", "label": "Link (optional)", "type": "url" }
      ]
    }
  ],
  "elements": [
    { "key": "heading", "label": "Heading", "kind": "text", "fields": ["heading"] },
    { "key": "subheading", "label": "Subheading", "kind": "text", "fields": ["subheading"] },
    { "key": "item", "label": "Gallery items", "kind": "box", "list": "images", "fields": ["image", "title", "caption", "link"] },
    { "key": "image", "label": "Images", "kind": "image", "list": "images", "fields": ["image"] },
    { "key": "title", "label": "Titles", "kind": "text", "list": "images", "fields": ["title"] }
  ],
  "defaults": {
    "heading": "Selected work",
    "subheading": "",
    "shape": "4/3",
    "captionOnHover": true,
    "images": [
      { "image": "https://images.unsplash.com/photo-1558655146-9f40138edfeb?w=900&q=80", "title": "Studio identity", "caption": "Branding", "link": "" },
      { "image": "https://images.unsplash.com/photo-1545235617-9465d2a55698?w=900&q=80", "title": "Coffee packaging", "caption": "Packaging", "link": "" },
      { "image": "https://images.unsplash.com/photo-1467232004584-a241de8bcf5d?w=900&q=80", "title": "Portfolio site", "caption": "Web", "link": "" },
      { "image": "https://images.unsplash.com/photo-1586717791821-3f44a563fa4c?w=900&q=80", "title": "App redesign", "caption": "Product", "link": "" },
      { "image": "https://images.unsplash.com/photo-1542744094-3a31f272c490?w=900&q=80", "title": "Campaign", "caption": "Marketing", "link": "" },
      { "image": "https://images.unsplash.com/photo-1561070791-2526d30994b5?w=900&q=80", "title": "Poster series", "caption": "Print", "link": "" }
    ]
  },
  "grid": { "desktop": 3, "tablet": 2, "mobile": 1, "gap": 16, "cardStyle": "none" }
}
