        {
          "type": "faq",
          "data": {
            "heading": "Orders & shipping",
            "items": [
              {
                "question": "How long does delivery take?",
                "answer": "Most orders arrive within 3–5 business days. Furniture ships within 2 weeks."
              },
              {
                "question": "Is shipping free?",
                "answer": "Yes, on all orders over $75. Otherwise shipping is a flat $6."
              },
              {
                "question": "Do you ship internationally?",
                "answer": "We ship to the US, Canada, the UK and the EU."
              }
            ]
          }
        },
        {
          "type": "faq",
          "data": {
            "anchor": "returns",
            "heading": "Returns & care",
            "items": [
              {
                "question": "What is your return policy?",
                "answer": "Return any unused item within 60 days for a full refund. Returns are free."
              },
              {
                "question": "How do I care for linen?",
                "answer": "Machine wash at 40°C and line dry. Linen gets softer with every wash."
              },
              {
                "question": "What if an item arrives damaged?",
                "answer": "Send us a photo within 7 days and we will replace it right away."
              }
            ]
          },
